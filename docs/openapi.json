{
  "openapi": "3.1.0",
  "info": {
    "title": "Checkpoint API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/version": {
      "get": {
        "summary": "Versão do deploy corrente",
        "description": "Pública (sem token). Lê app_release pelo deploy da Vercel; em dev usa package.json + git.",
        "security": [],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionInfo"
                }
              }
            }
          }
        }
      }
    },
    "/config": {
      "get": {
        "summary": "Configuração pública do front (Supabase Auth)",
        "description": "Pública (sem token). URL do projeto e publishable key são públicas por design; auth é null quando a autenticação não está configurada.",
        "security": [],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicConfig"
                }
              }
            }
          }
        }
      }
    },
    "/games": {
      "get": {
        "summary": "Biblioteca paginada",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "primaryGenre",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "store",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GamePage"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida"
          },
          "404": {
            "description": "Não encontrado"
          }
        }
      }
    },
    "/games/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Metadados do jogo",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Game"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida"
          },
          "404": {
            "description": "Não encontrado"
          }
        }
      },
      "patch": {
        "summary": "Salvar edição e recalcular",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GamePatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Game"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida"
          },
          "404": {
            "description": "Não encontrado"
          }
        }
      }
    },
    "/recommendations": {
      "get": {
        "summary": "Fila recalculada com contexto",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recommendations"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida"
          },
          "404": {
            "description": "Não encontrado"
          }
        },
        "description": "Sem /lists/{listId}: usa a lista padrão do usuário."
      }
    },
    "/catalog": {
      "get": {
        "summary": "Filtros e contagens",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida"
          },
          "404": {
            "description": "Não encontrado"
          }
        }
      }
    },
    "/lists": {
      "get": {
        "summary": "Listas do usuário",
        "description": "Mais antiga primeiro (a primeira é a lista padrão). Cria a lista \"Principal\" se o usuário ainda não tiver nenhuma.",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GameList"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Criar lista",
        "description": "Uma lista é só um nome: mostra todos os jogos, com pesos, regras e ordem manual próprios.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Criada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameList"
                }
              }
            }
          },
          "400": {
            "description": "Nome vazio ou com mais de 60 caracteres"
          },
          "409": {
            "description": "Já existe uma lista com esse nome (sem diferenciar maiúsculas)"
          }
        }
      }
    },
    "/lists/{listId}": {
      "parameters": [
        {
          "name": "listId",
          "in": "path",
          "required": true,
          "description": "Id (uuid) de uma lista do usuário",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "patch": {
        "summary": "Renomear lista",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameList"
                }
              }
            }
          },
          "400": {
            "description": "Nome inválido"
          },
          "404": {
            "description": "Lista não encontrada (inexistente ou de outro usuário)"
          },
          "409": {
            "description": "Nome repetido"
          }
        }
      },
      "delete": {
        "summary": "Apagar lista",
        "description": "Apaga a configuração, os ajustes manuais e o histórico da lista. Os jogos não são afetados.",
        "responses": {
          "204": {
            "description": "Apagada"
          },
          "404": {
            "description": "Lista não encontrada (inexistente ou de outro usuário)"
          },
          "409": {
            "description": "É a única lista do usuário"
          }
        }
      }
    },
    "/queue/reorder": {
      "post": {
        "summary": "Reordenar jogo da fila via ajuste manual de pontos",
        "description": "Calcula o delta de pontos flat (\"Ajuste manual\") para que o jogo caia em toPosition ao recalcular a fila gulosa. Verifica rodando o algoritmo (expansão + busca binária, resolução 0,1 ponto). Se a posição exata for impossível (predecessores, saltos de contexto), aplica a mais próxima e devolve exact=false. Acumula manualPoints e registra o movimento no histórico. Sem /lists/{listId}: usa a lista padrão do usuário.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReorderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReorderResult"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida"
          },
          "404": {
            "description": "Jogo não encontrado"
          },
          "409": {
            "description": "Jogo fora da fila (finalizado, abandonado, sem fim ou bloqueado) ou ajuste manual desativado nas configurações"
          }
        }
      }
    },
    "/queue/adjustments": {
      "get": {
        "summary": "Ajustes manuais e histórico de movimentos",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManualState"
                }
              }
            }
          }
        },
        "description": "Sem /lists/{listId}: usa a lista padrão do usuário."
      }
    },
    "/queue/adjustments/{gameId}": {
      "parameters": [
        {
          "name": "gameId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "delete": {
        "summary": "Zerar ajuste manual do jogo e recalcular",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManualResetResult"
                }
              }
            }
          },
          "404": {
            "description": "Jogo não encontrado"
          }
        },
        "description": "Sem /lists/{listId}: usa a lista padrão do usuário."
      }
    },
    "/settings/scoring": {
      "get": {
        "summary": "Configuração do algoritmo do usuário",
        "description": "Pesos, regras ligadas/desligadas, versão, padrões e metadados de cada fator (rótulo, descrição, unidade e faixa). Sem /lists/{listId}: usa a lista padrão do usuário.",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoringSettings"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Salvar pesos e regras",
        "description": "Valida (números finitos dentro da faixa de cada fator; regras booleanas; chaves desconhecidas são rejeitadas), grava, sobe a versão e invalida a fila. Sem /lists/{listId}: usa a lista padrão do usuário.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoringConfig"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Configuração salva",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoringSettings"
                }
              }
            }
          },
          "400": {
            "description": "Configuração inválida"
          }
        }
      }
    },
    "/settings/scoring/reset": {
      "post": {
        "summary": "Restaurar configuração padrão",
        "description": "Grava os padrões (nova versão) e invalida a fila. Sem /lists/{listId}: usa a lista padrão do usuário.",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoringSettings"
                }
              }
            }
          }
        }
      }
    },
    "/lists/{listId}/recommendations": {
      "get": {
        "summary": "Fila recalculada com contexto",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recommendations"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida"
          },
          "404": {
            "description": "Não encontrado"
          }
        }
      },
      "parameters": [
        {
          "name": "listId",
          "in": "path",
          "required": true,
          "description": "Id (uuid) de uma lista do usuário",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/lists/{listId}/queue/reorder": {
      "post": {
        "summary": "Reordenar jogo da fila via ajuste manual de pontos",
        "description": "Calcula o delta de pontos flat (\"Ajuste manual\") para que o jogo caia em toPosition ao recalcular a fila gulosa. Verifica rodando o algoritmo (expansão + busca binária, resolução 0,1 ponto). Se a posição exata for impossível (predecessores, saltos de contexto), aplica a mais próxima e devolve exact=false. Acumula manualPoints e registra o movimento no histórico.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReorderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReorderResult"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida"
          },
          "404": {
            "description": "Jogo não encontrado"
          },
          "409": {
            "description": "Jogo fora da fila (finalizado, abandonado, sem fim ou bloqueado) ou ajuste manual desativado nas configurações"
          }
        }
      },
      "parameters": [
        {
          "name": "listId",
          "in": "path",
          "required": true,
          "description": "Id (uuid) de uma lista do usuário",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/lists/{listId}/queue/adjustments": {
      "get": {
        "summary": "Ajustes manuais e histórico de movimentos",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManualState"
                }
              }
            }
          },
          "404": {
            "description": "Lista não encontrada (inexistente ou de outro usuário)"
          }
        }
      },
      "parameters": [
        {
          "name": "listId",
          "in": "path",
          "required": true,
          "description": "Id (uuid) de uma lista do usuário",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/lists/{listId}/queue/adjustments/{gameId}": {
      "parameters": [
        {
          "name": "listId",
          "in": "path",
          "required": true,
          "description": "Id (uuid) de uma lista do usuário",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "gameId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "delete": {
        "summary": "Zerar ajuste manual do jogo e recalcular",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManualResetResult"
                }
              }
            }
          },
          "404": {
            "description": "Jogo não encontrado"
          }
        }
      }
    },
    "/lists/{listId}/settings/scoring": {
      "get": {
        "summary": "Configuração do algoritmo do usuário",
        "description": "Pesos, regras ligadas/desligadas, versão, padrões e metadados de cada fator (rótulo, descrição, unidade e faixa).",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoringSettings"
                }
              }
            }
          },
          "404": {
            "description": "Lista não encontrada (inexistente ou de outro usuário)"
          }
        }
      },
      "put": {
        "summary": "Salvar pesos e regras",
        "description": "Valida (números finitos dentro da faixa de cada fator; regras booleanas; chaves desconhecidas são rejeitadas), grava, sobe a versão e invalida a fila.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoringConfig"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Configuração salva",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoringSettings"
                }
              }
            }
          },
          "400": {
            "description": "Configuração inválida"
          },
          "404": {
            "description": "Lista não encontrada (inexistente ou de outro usuário)"
          }
        }
      },
      "parameters": [
        {
          "name": "listId",
          "in": "path",
          "required": true,
          "description": "Id (uuid) de uma lista do usuário",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/lists/{listId}/settings/scoring/reset": {
      "post": {
        "summary": "Restaurar configuração padrão",
        "description": "Grava os padrões (nova versão) e invalida a fila.",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoringSettings"
                }
              }
            }
          },
          "404": {
            "description": "Lista não encontrada (inexistente ou de outro usuário)"
          }
        }
      },
      "parameters": [
        {
          "name": "listId",
          "in": "path",
          "required": true,
          "description": "Id (uuid) de uma lista do usuário",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
