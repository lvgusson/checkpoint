          "releaseDate": {
            "type": ["string", "null"],
            "format": "date"
          },
          "headerUrl": {
            "type": ["string", "null"]
          },
          "capsuleUrl": {
            "type": ["string", "null"]
          },
          "heroUrl": {
            "type": ["string", "null"]
          },
          "storeUrl": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/SteamPrice"
          }
        }
