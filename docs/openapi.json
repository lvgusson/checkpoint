                  "type": "string"
                }
              },
              "desire": {
                "type": "string"
              },
              "store": {
                "type": "string"
              },
              "platform": {
                "type": "string"
              },
              "pace": {
                "type": "string"
              },
              "structure": {
                "type": "string"
              },
              "coop": {
                "type": "string"
              },
              "mechanic": {
                "type": "string"
              },
              "size": {
                "type": "string"
              },
