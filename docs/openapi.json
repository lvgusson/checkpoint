  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "access_token da sessão do Supabase Auth. Sem token válido as rotas protegidas respondem 401 (503 se a verificação de chaves estiver indisponível)."
      }
    },
    "schemas": {
      "VersionInfo": {
        "type": "object",
        "required": ["version", "gitSha", "environment", "deployedAt"],
        "properties": {
          "version": {
            "type": "string",
            "description": "semver do package.json"
          },
          "gitSha": {
            "type": ["string", "null"]
          },
          "environment": {
            "type": "string",
            "enum": ["production", "preview", "development"]
          },
          "deployedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        }
      },
      "PublicConfig": {
        "type": "object",
        "required": ["auth"],
        "properties": {
          "auth": {
            "type": ["object", "null"],
            "required": ["supabaseUrl", "supabasePublishableKey", "providers"],
            "properties": {
              "supabaseUrl": {
                "type": "string",
                "format": "uri"
              },
              "supabasePublishableKey": {
                "type": "string"
              },
              "providers": {
                "type": "object",
                "properties": {
                  "github": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      },
      "Game": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "primaryGenre": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["Não iniciado", "Jogando", "Abandonado", "Finalizado"]
          },
          "desire": {
            "type": "string",
            "enum": ["Muito Alta", "Alta", "Média", "Baixa", "Muito Baixa"]
          },
          "store": {
            "type": "string"
          },
          "actualHours": {
            "type": ["number", "null"]
          },
          "startedAt": {
            "type": ["string", "null"]
          },
          "finishedAt": {
            "type": ["string", "null"]
          },
          "rating": {
            "type": ["number", "null"]
          },
          "notes": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "secondaryTags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pace": {
            "type": "string"
          },
          "structure": {
            "type": "string"
          },
          "mainHours": {
            "type": ["number", "null"]
          },
          "extraHours": {
            "type": ["number", "null"]
          },
          "completionistHours": {
            "type": ["number", "null"]
          },
          "size": {
            "type": "string"
          },
          "timeVerification": {
            "type": "string"
          },
          "timeSource": {
            "type": "string"
          },
          "reviewNotes": {
            "type": "string"
          },
          "previousEstimatedHours": {
            "type": ["number", "null"]
          },
          "coop": {
            "type": "string"
          },
          "mechanic": {
            "type": "string"
          },
          "prerequisiteId": {
            "type": ["string", "null"]
          },
          "imported": {
            "type": "object",
            "properties": {
              "plannedHours": {
                "type": ["number", "null"]
              },
              "affinity": {
                "type": ["number", "null"]
              },
              "baseScore": {
                "type": ["number", "null"]
              },
              "queueScore": {
                "type": ["number", "null"]
              },
              "previousPendingId": {
                "type": ["string", "null"]
              }
            }
          },
          "updatedAt": {
            "type": ["string", "null"]
          },
          "plannedHours": {
            "type": ["number", "null"]
          },
          "affinity": {
            "type": "number"
          },
          "baseScore": {
