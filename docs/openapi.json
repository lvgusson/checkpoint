          "initialCents": {
            "type": ["integer", "null"]
          },
          "finalCents": {
            "type": ["integer", "null"]
          },
          "discountPercent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "discountEndsAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "isFree": {
            "type": "boolean"
          },
          "formatted": {
            "type": ["string", "null"],
            "example": "R$46,99"
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
