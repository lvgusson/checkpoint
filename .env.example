# Copie para .env e preencha. .env nunca deve ser commitado.
# Supabase Dashboard > Project Settings > API Keys / Database.

# Projeto
SUPABASE_PROJECT_REF=
SUPABASE_URL=

# Chave pública (pode ir para o front). Substitui a antiga "anon key".
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (somente servidor; ignora RLS). Substitui a antiga "service_role key".
SUPABASE_SECRET_KEY=

# Senha do banco (usada por `supabase db push` e pelos scripts de seed)
SUPABASE_DB_PASSWORD=

# API Node: pooler Supavisor em modo transação (porta 6543)
DATABASE_URL=
# Migrations/seed: pooler em modo sessão (porta 5432, IPv4)
DATABASE_URL_SESSION=
# Conexão direta (IPv6): db.<ref>.supabase.co:5432
DIRECT_URL=

# Token de acesso do Supabase CLI (opcional; para `supabase link`, `db advisors --linked`)
SUPABASE_ACCESS_TOKEN=

# Auth: liga o botão "Entrar com GitHub" no front (provider configurado no Supabase)
AUTH_GITHUB_ENABLED=

# E-mail do dono dos dados do seed: no primeiro login com este e-mail, o app_user do seed
# (00000000-0000-4000-8000-000000000001) é vinculado à conta do Supabase Auth.
SEED_OWNER_EMAIL=

# Opcional: tamanho do pool do driver Postgres por instância (padrão 5)
PG_POOL_MAX=
