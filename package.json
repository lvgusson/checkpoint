{
  "name": "checkpoint-games",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env api/src/server.ts",
    "dev": "node scripts/dev.mjs",
    "build": "ng build",
    "vercel-build": "ng build && node scripts/record-release.mjs",
    "release:list": "node --env-file-if-exists=.env scripts/rollback.mjs list",
    "release:rollback": "node --env-file-if-exists=.env scripts/rollback.mjs rollback",
    "release:tag": "node scripts/rollback.mjs tag",
    "wishlist:import": "node --env-file-if-exists=.env --env-file-if-exists=local-env.env api/src/wishlist-cli.ts",
    "test": "node --test api/test/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "typecheck": "tsc -p api/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@vercel/functions": "^3.9.11",
    "jose": "^6.2.12",
    "postgres": "3.4.9",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
