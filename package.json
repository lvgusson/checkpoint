{
  "name": "checkpoint-games",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/api/src/server.ts",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @checkpoint/web build",
    "vercel-build": "pnpm --filter @checkpoint/web build && node apps/api/scripts/record-release.mjs",
    "master:create": "node --env-file-if-exists=.env --env-file-if-exists=local-env.env apps/api/scripts/master-user.mjs",
    "release:list": "node --env-file-if-exists=.env apps/api/scripts/rollback.mjs list",
    "release:note": "node --env-file-if-exists=.env --env-file-if-exists=local-env.env apps/api/scripts/release-note.mjs",
    "release:rollback": "node --env-file-if-exists=.env apps/api/scripts/rollback.mjs rollback",
    "release:tag": "node --env-file-if-exists=.env apps/api/scripts/rollback.mjs tag",
    "wishlist:import": "node --env-file-if-exists=.env --env-file-if-exists=local-env.env apps/api/src/wishlist-cli.ts",
    "wishlist:export": "node --env-file-if-exists=.env --env-file-if-exists=local-env.env apps/api/src/wishlist-cli.ts --export",
    "wishlist:seed": "node --env-file-if-exists=.env --env-file-if-exists=local-env.env apps/api/src/wishlist-cli.ts --from",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "typecheck": "tsc -p apps/api/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
