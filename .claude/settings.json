{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-on-stop.sh",
            "timeout": 600,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm install)",
      "Bash(bd ready)",
      "Bash(bd show *)",
      "Bash(bd prime)"
    ],
    "ask": ["Bash(git commit *)", "Bash(git push *)"]
  },
  "env": {
    "PONYTAIL_DEFAULT_MODE": "off",
    "PONYTAIL_MAP": "0"
  }
}
