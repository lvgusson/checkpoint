{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["pdx1"],
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "apps/web/dist/web/browser" }
    },
    {
      "src": "apps/api/index.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "apps/api/src/**",
          "packages/core/src/**",
          "apps/api/openapi.json",
          "apps/api/package.json"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/apps/api/index.mjs" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
