{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "../web/node_modules/vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "../../packages/core/src/**/*.ts",
    "test/**/*.ts",
    "../../vitest.config.ts"
  ]
}
