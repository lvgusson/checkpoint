{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@checkpoint/ui-react": ["../../packages/ui-react/src/index.ts"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    }
  },
  "include": ["src", "../../packages/ui-react/src"]
}
